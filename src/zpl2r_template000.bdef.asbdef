managed implementation in class ZPL2BP_R_TEMPLATE000 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZPL2R_TEMPLATE000 alias Template
persistent table ZPL2TEMPLATE000
extensible
draft table ZPL2TMPLATE000_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly )
   UUID,
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( numbering : managed )
   UUID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZPL2TEMPLATE000 corresponding extensible
  {
    UUID = uuid;
    TemplateName = template_name;
    Description = description;
    IsActive = is_active;
    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }

  association _TemplateModule { create; with draft; }

}

define behavior for ZPL2R_TMPLTMDLE alias TemplateModule
persistent table ZPL2TMPLTMDLE000
extensible
draft table ZPL2TMPLTMDLE_D
etag dependent by _Template
lock dependent by _Template
authorization dependent by _Template
{
  field ( readonly )
   UUID,
   ParentUUID;

  field ( numbering : managed )
   UUID;


  update;
  delete;

  mapping for ZPL2TMPLTMDLE000 corresponding extensible
  {
    UUID = uuid;
    ParentUUID = parent_uuid;
    ModuleName = module_name;
    Sequence = sequence;
    Track = track;
    DurationDays = duration_days;
    AnchorDay = anchor_day;
    PrerequisiteModuleUUID = prerequisite_module_uuid;
    IsSwappable = is_swappable;
  }

  association _Template { with draft; }
  association _TemplateItem { create; with draft; }

}

define behavior for ZPL2R_TMPLTITEM alias TemplateItem
persistent table ZPL2TMPLTITEM000
extensible
draft table ZPL2TMPLTITEM_D
etag dependent by _Template
lock dependent by _Template
authorization dependent by _Template
{
  field ( readonly )
