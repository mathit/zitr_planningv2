    Title = title;
    DayOffset = day_offset;
    TimeFrom = time_from;
    TimeTo = time_to;
    ItemType = item_type;
    Location = location;
    LeadTeacherUUID = lead_teacher_uuid;
    RoomType = room_type;
  }

  association _Template { with draft; }
  association _TemplateModule { with draft; }
  association _TemplateItemTeacher { create; with draft; }

}

define behavior for ZPL2R_TMPLTTMTCHER alias TemplateItemTeacher
persistent table ZPL2TMPLTTMTCHER
extensible
draft table ZPL2TMPLTTMTCH_D
etag dependent by _Template
