managed implementation in class ZPL2BP_R_TEMPLATE unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZPL2R_TEMPLATE alias Template
persistent table ZPL2TEMPLATE
extensible
draft table ZPL2TEMPLATE_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( readonly )
   UUID,
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( numbering : managed )
   UUID;


  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZPL2TEMPLATE corresponding extensible
  {
    UUID = uuid;
    TemplateName = template_name;
    Description = description;
    IsActive = is_active;
    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }

  association _TemplateModule { create; with draft; }

}

define behavior for ZPL2R_TMPLTEMODULE alias TemplateModule
persistent table ZPL2TMPLTEMODULE
extensible
draft table ZPL2TMPLTMDULE_D
etag dependent by _Template
lock dependent by _Template
authorization dependent by _Template
{
  field ( readonly )
   UUID,
   ParentUUID;

  field ( numbering : managed )
   UUID;


  update;
  delete;

  mapping for ZPL2TMPLTEMODULE corresponding extensible
  {
    UUID = uuid;
    ParentUUID = parent_uuid;
    ModuleName = module_name;
    Sequence = sequence;
    Track = track;
    DurationDays = duration_days;
    AnchorDay = anchor_day;
    PrerequisiteModuleUUID = prerequisite_module_uuid;
    IsSwappable = is_swappable;
  }

  association _Template { with draft; }
  association _TemplateItem { create; with draft; }

}

define behavior for ZPL2R_TEMPLATEITEM alias TemplateItem
persistent table ZPL2TEMPLATEITEM
extensible
draft table ZPL2TMPLTEITEM_D
etag dependent by _Template
lock dependent by _Template
authorization dependent by _Template
{
  field ( readonly )
   UUID,
   ParentUUID,
   RootUUID;

  field ( numbering : managed )
   UUID;


  update;
  delete;

  mapping for ZPL2TEMPLATEITEM corresponding extensible
  {
    UUID = uuid;
    ParentUUID = parent_uuid;
    RootUUID = root_uuid;
    Title = title;
    DayOffset = day_offset;
    TimeFrom = time_from;
    TimeTo = time_to;
    ItemType = item_type;
    Location = location;
    DefaultTeacherUUID = default_teacher_uuid;
    RoomType = room_type;
  }

  association _Template { with draft; }
  association _TemplateModule { with draft; }

}