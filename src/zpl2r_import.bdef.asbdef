managed implementation in class ZPL2BP_R_IMPORT unique;
strict ( 2 );

define behavior for ZPL2R_IMPORT alias Import
persistent table zpl2import
lock master
authorization master ( global )
etag master LocalLastChangedAt
{
  field ( readonly )
   UUID,
   Status,
   Message,
   LocalCreatedBy,
   LocalCreatedAt,
   LocalLastChangedBy,
   LocalLastChangedAt,
   LastChangedAt;

  field ( numbering : managed )
   UUID;

  create;
  update;
  delete;

  action runImport result [1] $self;

  mapping for zpl2import corresponding
  {
    UUID = uuid;
    FileName = file_name;
    MimeType = mime_type;
    Attachment = attachment;
    Status = status;
    Message = message;
    LocalCreatedBy = local_created_by;
    LocalCreatedAt = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }
}